{
  "name": "alchemists-website",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local ./node_modules/vite/bin/vite.js --host 127.0.0.1 --port 3000",
    "dev:vercel": "node --env-file-if-exists=.env.local ./node_modules/.bin/vc dev --listen 3000",
    "build": "vite build",
    "command-center:replay": "node --env-file-if-exists=.env.local scripts/replay-command-center-telemetry.js",
    "preview": "vite preview",
    "test": "node --test",
    "command-center:verify:browser": "node scripts/verify-command-center.mjs",
    "command-center:verify:db": "node scripts/verify-command-center-db.mjs",
    "command-center:measure": "node scripts/measure-command-center.mjs"
  },
  "devDependencies": {
    "pg": "^8.20.0",
    "playwright": "^1.63.0",
    "vercel": "^54.4.1",
    "vite": "^8.0.13"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "phaser": "^4.2.1"
  }
}
